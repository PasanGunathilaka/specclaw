#!/usr/bin/env python3
# specclaw-preset-check — the mechanical rules of presets/*.md, as one gate.
#
# Usage: specclaw-preset-check [<root>] [--max-lines N]
#   Checks git-tracked and untracked-but-not-ignored code files under <root>:
#     max_lines  a file longer than max_lines (preset_overrides.max_lines, default 80)
#     comment    a whole-line comment that is not a tool pragma
#     layer      (dotnet) a ProjectReference from an inner Clean Architecture layer
#                to an outer one: Domain < Application < Infrastructure < Api
#   Exclusions: lib/quality-exclusions.yaml plus the project's quality.exclusions,
#   except the `tests` category — the preset rules bind test code too.
# Output: JSON on stdout. Exit: 0 clean, 1 violations, 2 usage error.
import json, os, re, subprocess, sys

CODE = {".py": "py", ".ts": "c", ".tsx": "c", ".js": "c", ".jsx": "c", ".mjs": "c", ".cjs": "c", ".cs": "c"}
PRAGMA = re.compile(r"(eslint-(disable|enable)|@ts-|prettier-ignore|type:\s*ignore|noqa|pyright:|mypy:|istanbul ignore|c8 ignore|<reference |ReSharper )")
LAYERS = ["domain", "application", "infrastructure", "api"]
LIB = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib", "quality-exclusions.yaml")


def yaml_section(path, keys):
    """Return {name: value-or-list} for the block at `keys` in a simple YAML file."""
    out, stack, cur = {}, [], None
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return out
    for raw in lines:
        line = raw.split(" #")[0].rstrip() if not raw.lstrip().startswith("- ") else raw.rstrip()
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        ind = len(line) - len(line.lstrip())
        body = line.strip()
        if body.startswith("- "):
            if cur is not None and [k for _, k in stack] == keys + [cur]:
                out.setdefault(cur, []).append(body[2:].split(" #")[0].strip().strip("\"'"))
            continue
        name, _, val = body.partition(":")
        while stack and stack[-1][0] >= ind:
            stack.pop()
        if [k for _, k in stack] == keys:
            cur, val = name, val.strip()
            if val in ("[]", "{}"):
                out[name] = []
            elif val:
                out[name] = val.strip("\"'")
        stack.append((ind, name))
    return out


def override(cfg, key, default):
    try:
        text = open(cfg, encoding="utf-8").read()
    except OSError:
        return default
    m = re.search(r"^preset_overrides:\s*\{([^}]*)\}", text, re.M)
    pairs = dict(p.split(":", 1) for p in m.group(1).split(",") if ":" in p) if m else {}
    pairs = {k.strip(): v.strip() for k, v in pairs.items()} or yaml_section(cfg, ["preset_overrides"])
    return pairs.get(key, default) or default


def glob_re(g):
    g = g.strip().lstrip("./")
    rx = re.escape(g).replace(r"\*\*/", "(?:.*/)?").replace(r"\*\*", ".*").replace(r"\*", "[^/]*").replace(r"\?", "[^/]")
    return re.compile("^" + rx + "$", re.I)


def exclusions(cfg):
    defaults = yaml_section(LIB, ["quality", "exclusions"])
    project = yaml_section(cfg, ["quality", "exclusions"])
    pats = []
    for cat, globs in defaults.items():
        if isinstance(globs, list) and cat not in ("tests", "extra_excludes", "include_overrides"):
            if str(project.get(cat, "true")).lower() != "false":
                pats += globs
    extra = project.get("extra_excludes", [])
    pats += extra if isinstance(extra, list) else []
    keep = project.get("include_overrides", [])
    return [glob_re(p) for p in pats], [glob_re(p) for p in (keep if isinstance(keep, list) else [])]


def files(root):
    try:
        out = subprocess.run(["git", "-C", root, "ls-files", "--cached", "--others", "--exclude-standard"],
                             capture_output=True, text=True, check=True).stdout.splitlines()
        if out or os.path.isdir(os.path.join(root, ".git")):
            return sorted(set(out))
    except (OSError, subprocess.CalledProcessError):
        pass
    found = []
    for d, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if x != ".git"]
        found += [os.path.relpath(os.path.join(d, n), root) for n in names]
    return sorted(found)


def comment(kind, s, state):
    if state["block"]:
        if "*/" in s:
            state["block"] = False
        return True
    if kind == "py":
        return s.startswith("#") and not s.startswith("#!")
    if s.startswith("/*"):
        state["block"] = "*/" not in s
        return True
    return s.startswith("//")


def layer(name):
    last = name.lower().rsplit(".", 1)[-1]
    return LAYERS.index(last) if last in LAYERS else None


def check_layers(root, rel, out):
    src = layer(os.path.splitext(os.path.basename(rel))[0])
    if src is None:
        return
    text = open(os.path.join(root, rel), encoding="utf-8", errors="replace").read()
    for ref in re.findall(r'<ProjectReference\s+Include="([^"]+)"', text):
        dst = layer(os.path.splitext(os.path.basename(ref.replace("\\", "/")))[0])
        if dst is not None and dst > src:
            out.append({"rule": "layer", "file": rel, "references": ref,
                        "detail": f"{LAYERS[src]} must not reference {LAYERS[dst]}"})


def main(argv):
    root, max_lines = ".", None
    args = list(argv)
    while args:
        a = args.pop(0)
        if a == "--max-lines" and args:
            max_lines = int(args.pop(0))
        elif a.startswith("-"):
            print(f"unknown option: {a}", file=sys.stderr)
            return 2
        else:
            root = a
    if not os.path.isdir(root):
        print(f"no such directory: {root}", file=sys.stderr)
        return 2
    cfg = os.path.join(root, ".specclaw", "config.yaml")
    if max_lines is None:
        raw = override(cfg, "max_lines", 80)
        if not str(raw).isdigit():
            print(f"preset_overrides.max_lines must be a whole number, got {raw!r}", file=sys.stderr)
            return 2
        max_lines = int(raw)
    excl, keep = exclusions(cfg)
    violations, checked = [], 0
    for rel in files(root):
        rel = rel.replace(os.sep, "/")
        if any(r.match(rel) for r in excl) and not any(r.match(rel) for r in keep):
            continue
        if rel.endswith(".csproj"):
            check_layers(root, rel, violations)
            continue
        kind = CODE.get(os.path.splitext(rel)[1].lower())
        if not kind or not os.path.isfile(os.path.join(root, rel)):
            continue
        checked += 1
        lines = open(os.path.join(root, rel), encoding="utf-8", errors="replace").read().splitlines()
        if len(lines) > max_lines:
            violations.append({"rule": "max_lines", "file": rel, "lines": len(lines), "max": max_lines})
        state = {"block": False}
        for n, line in enumerate(lines, 1):
            s = line.strip()
            if comment(kind, s, state) and not PRAGMA.search(s):
                violations.append({"rule": "comment", "file": rel, "line": n, "text": s[:80]})
    print(json.dumps({"root": root, "max_lines": max_lines, "files_checked": checked,
                      "violations": violations}, indent=2))
    return 1 if violations else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
