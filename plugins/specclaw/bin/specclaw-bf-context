#!/usr/bin/env bash
# specclaw-bf-context — generate a project context router skill from the
# SpecClaw artifacts a brownfield project has already produced.
#
# THE OUTPUT IS A ROUTER, NOT A SUMMARY. It contains no domain rule, no
# decision, no stack name and no id beyond the module list — only where each
# question is answered, and the working rules for answering it. A generated file
# that restated what the artifacts say would be a second copy of them, stale the
# moment either side changed, and a reader who trusted it over the real document
# would be reading last week's answer. Pointers cannot go stale that way: the
# path is still the path even when the content behind it moves on.
#
# Pure bash + coreutils. Spawns no agent, reads project knowledge only from
# files under <specclaw_dir>, and writes exactly one file. The single read
# outside that directory is the target skill itself, and only to check for the
# generated-by marker before overwriting — nothing in it is otherwise parsed or
# carried forward.
#
# Nothing else in specclaw reads this file, references this command, or changes
# behaviour when it exists. It is entirely optional: delete the output and every
# command behaves identically.

set -euo pipefail

MARKER="<!-- generated by specclaw-bf-context — do not edit; re-run /specclaw:bf-context -->"

usage() {
  cat <<'EOF'
Usage: specclaw-bf-context <specclaw_dir> [project_root]

Generate a project context router skill at
<project_root>/.claude/skills/<project>-context/SKILL.md from the SpecClaw
artifacts under <specclaw_dir>.

The generated skill is a ROUTER: it names the project, lists which
authoritative artifacts exist and which question each answers, lists the
MOD-### modules with their titles, and carries the module map's own Status
line and the blueprint's own status line verbatim. It contains no rule, no
decision, no stack name, and copies nothing.

project_root defaults to the parent directory of <specclaw_dir>.

Absent artifacts are reported as "not present" and are never fatal. The one
refusal is a target file that exists WITHOUT this command's generated-by
marker: that is a hand-written skill and is never overwritten.

Options:
  -h, --help    Show this help message
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") usage >&2; echo >&2; echo "ERROR: <specclaw_dir> is required." >&2; exit 2 ;;
esac

SPECCLAW_DIR="$1"
if [ ! -d "$SPECCLAW_DIR" ]; then
  echo "ERROR: '$SPECCLAW_DIR' does not exist or is not a directory. Run /specclaw:init first." >&2
  exit 2
fi

PROJECT_ROOT="${2:-$(cd "$SPECCLAW_DIR/.." && pwd)}"

ANALYSIS="$SPECCLAW_DIR/analysis"

# ─── Project name ─────────────────────────────────────────────────────────────

# `<section>.<key>` from config.yaml. The same trimmed-down reader
# specclaw-bf-status and specclaw-update-status each carry; duplicated rather
# than sourced because these bin scripts are deliberately standalone.
cfg_val() {
  local section="$1" key="$2" v
  v=$(sed -n "/^${section}:/,/^[a-zA-Z_]/{s/^[[:space:]][[:space:]]*${key}:[[:space:]]*//p;}" \
    "$SPECCLAW_DIR/config.yaml" 2>/dev/null | head -1 || true)
  if [[ "$v" =~ ([[:space:]]+#) ]]; then v="${v%%"${BASH_REMATCH[1]}"*}"; fi
  v="${v%"${v##*[![:space:]]}"}"
  v="${v#\"}"; v="${v%\"}"; v="${v#\'}"; v="${v%\'}"
  printf '%s' "$v"
}

PROJECT_NAME="$(cfg_val project name)"
if [ -z "$PROJECT_NAME" ]; then
  # Deliberately NOT a basename fallback. The generated skill is addressed by
  # the project's name and a directory basename is not one — it is whatever the
  # checkout happens to be called, differs between two clones of the same
  # project, and would silently produce two differently-named skills for one
  # codebase. The recorded name is the answer, and its absence is a question for
  # a human rather than something to guess around.
  echo "ERROR: no project name recorded in $SPECCLAW_DIR/config.yaml (project.name is empty)." >&2
  echo "       Set it, or run /specclaw:init, then re-run this command." >&2
  exit 2
fi

# The directory basename becomes the command a user types, so it has to be a
# lowercase hyphenated slug whatever the recorded name looks like. The recorded
# name itself is what the generated body and description say.
PROJECT_SLUG="$(printf '%s' "$PROJECT_NAME" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
if [ -z "$PROJECT_SLUG" ]; then PROJECT_SLUG="project"; fi

OUT_DIR="$PROJECT_ROOT/.claude/skills/${PROJECT_SLUG}-context"
OUT_FILE="$OUT_DIR/SKILL.md"

# ─── Overwrite guard ──────────────────────────────────────────────────────────
#
# Full regeneration is safe precisely because nothing here is authored: every
# line is derived, so there is nothing to lose and no archive-then-replace
# question to answer. That reasoning holds only for a file THIS command wrote,
# which is what the marker establishes. Anything else is somebody's own writing.
if [ -f "$OUT_FILE" ] && ! grep -qF -- "$MARKER" "$OUT_FILE"; then
  echo "ERROR: $OUT_FILE exists but was not generated by this command." >&2
  echo "       It carries no generated-by marker, so it is hand-written and will not be" >&2
  echo "       overwritten. Move or delete it first if you want a generated router here." >&2
  exit 1
fi

# ─── Artifact presence ────────────────────────────────────────────────────────

MAP="$ANALYSIS/module-map.md"
TARGET_ARCH="$ANALYSIS/target-architecture.md"

# Every row: <path>|<the question it answers>. The questions are fixed text and
# name no framework, language or vendor — this command is stack-blind, and a
# product name in a bash generator would be an architectural defect rather than
# a convenience.
ROWS='analysis/module-map.md|Which module owns this entity, rule, service or screen, and what does it depend on?
analysis/domain-model.md|What are the business entities, their relationships, rules and enumerations?
analysis/functional-spec.md|What can a user actually do — capabilities, workflows, screens, named gaps?
analysis/decisions.md|What was decided, by which named person, and on what date?
analysis/target-architecture.md|What is being built, and what does each part of it rest on?
analysis/rebuild-backlog.md|What work remains, in what order, and what accepts each item?
analysis/module-status.md|Per module: items planned, scenarios captured, latest replay verdict.
analysis/quality.json|Which parts of the code measured badly, and on which dimension?
baseline/scenarios.md|Which behaviours were designed to be captured as fixtures?
baseline/manifest.json|Which fixtures were actually recorded, and what does each pin?
baseline/error-map.md|What does this project'"'"'s own semantic error vocabulary mean?
bootstrap/bootstrap-manifest.json|Is the target foundation standing, and on what stack?'

MISSING=""
PRESENT_COUNT=0
TOTAL_COUNT=0

# ─── Modules ──────────────────────────────────────────────────────────────────
#
# Read from module-map.md's own `### MOD-###` headings, verbatim. Withdrawn
# modules are carried through exactly as the map states them: a MOD id is a
# permanent claim on that id, and a tombstone is a fact about the map, not a gap
# to tidy away. Nothing here mints, renumbers or interprets an id.
MODULE_LINES=""
MODULE_COUNT=0
if [ -f "$MAP" ]; then
  MODULE_LINES="$({ grep -E '^### MOD-[0-9]+' "$MAP" 2>/dev/null || true; } \
    | sed -E 's/^### //; s/[[:space:]]+$//')"
  MODULE_COUNT="$(printf '%s' "$MODULE_LINES" | { grep -c . || true; })"
fi

# The map's and the blueprint's own status lines, verbatim. Both are a human- or
# bash-written verdict about how much the documents behind them can be trusted,
# and paraphrasing either would be inventing confidence neither states.
MAP_STATUS=""
if [ -f "$MAP" ]; then
  MAP_STATUS="$({ grep -m1 -- '^\*\*Status:\*\*' "$MAP" 2>/dev/null || true; } | sed -E 's/[[:space:]]+$//')"
fi
BP_STATUS=""
if [ -f "$TARGET_ARCH" ]; then
  BP_STATUS="$({ grep -m1 -- '^\*\*Blueprint status:\*\*' "$TARGET_ARCH" 2>/dev/null || true; } | sed -E 's/[[:space:]]+$//')"
fi

# ─── Render ───────────────────────────────────────────────────────────────────

# The recorded name is free text and the description is a quoted YAML scalar,
# so a stray quote or backslash in it would break the frontmatter this skill is
# identified by.
DESC_NAME="$(printf '%s' "$PROJECT_NAME" | sed 's/\\/\\\\/g; s/"/\\"/g')"

mkdir -p "$OUT_DIR"

{
  printf -- '---\n'
  printf 'description: "Project context router for %s — %s modules. Read before touching any module, rule, or decision; points to the SpecClaw artifacts that are the source of truth."\n' \
    "$DESC_NAME" "$MODULE_COUNT"
  printf -- '---\n\n'

  # The marker sits on the first line AFTER the frontmatter, never before it:
  # Claude Code reads frontmatter only when the opening `---` is the file's very
  # first line, so a leading comment would silently cost this skill both its
  # description and its name — and the guard below would then be checking a file
  # nothing could load.
  printf '%s\n\n' "$MARKER"

  printf '# %s — project context\n\n' "$PROJECT_NAME"

  cat <<'INTRO'
Where this project's questions are answered. This file routes; it does not answer.
Every claim below about a module, a rule or a decision lives in one of the
documents named here, and those documents are the source of truth.

## Authoritative artifacts

| Artifact | Answers | State |
|---|---|---|
INTRO

  # shellcheck disable=SC2016  # backticks here are markdown code spans in the output
  while IFS='|' read -r relpath question; do
    [ -n "$relpath" ] || continue
    TOTAL_COUNT=$((TOTAL_COUNT + 1))
    if [ -f "$SPECCLAW_DIR/$relpath" ]; then
      state='present'
      PRESENT_COUNT=$((PRESENT_COUNT + 1))
    else
      state='not present'
      MISSING="${MISSING}${relpath}
"
    fi
    printf '| `.specclaw/%s` | %s | %s |\n' "$relpath" "$question" "$state"
  done <<EOF
$ROWS
EOF

  printf '\n## Modules\n\n'
  if [ ! -f "$MAP" ]; then
    printf 'module-map.md not present — run /specclaw:bf-domain.\n\n'
  elif [ "$MODULE_COUNT" -eq 0 ]; then
    printf 'module-map.md is present but declares no MOD- heading yet.\n\n'
  else
    printf '%s\n' "$MODULE_LINES" | sed 's/^/- /'
    printf '\n'
  fi
  if [ -n "$MAP_STATUS" ]; then printf 'Module map %s\n\n' "$MAP_STATUS"; fi
  if [ -n "$BP_STATUS" ]; then printf 'Target %s\n\n' "$BP_STATUS"; fi

  cat <<'RULES'
## Working rules

- **Read the artifact before making a claim** about a module, a rule or a
  decision. A recollection is not a citation, and this file deliberately holds
  neither.
- **Cite the id.** An answer carries the `SQ`, `CQ` or `DR` id of wherever it
  came from, so a reader can go and check it rather than take it on trust.
- **When the artifacts do not answer, ask.** Append a `PQ-###` entry to
  `.specclaw/analysis/pending-questions.md` rather than inferring one. An
  inference recorded as a fact is the failure this pipeline exists to prevent.
- **Never hand-edit anything under `.specclaw/analysis/` or
  `.specclaw/baseline/`.** Those documents are regenerated by their own
  commands, so a hand edit is lost on the next run — silently, and usually long
  after it mattered.
- **`target-architecture.md` and `module-map.md` are readability artifacts.**
  They make the shape of the system legible. They are not evidence: a
  behavioural verdict comes from replaying recorded fixtures, never from
  reading a diagram.

---

Generated from the artifacts present at generation time. Nothing reads this file
and nothing depends on it — re-run `/specclaw:bf-context` to refresh it, or
delete it and the project behaves identically.
RULES
} > "$OUT_FILE"

# ─── Report ───────────────────────────────────────────────────────────────────

echo "OK: wrote $OUT_FILE"
echo "  project: $PROJECT_NAME"
echo "  modules: $MODULE_COUNT"
echo "  artifacts present: $PRESENT_COUNT/$TOTAL_COUNT"
if [ -n "$MISSING" ]; then
  echo "  not present:"
  printf '%s' "$MISSING" | sed 's/^/    - /'
fi
echo
echo "  Remember to \`git add\` it so the rest of the team gets the same router."
